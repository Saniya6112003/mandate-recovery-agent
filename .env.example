# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Which reasoning backend to use:
#   gemini    — Google AI Studio free tier, real model, no cost, no card
#   anthropic — Claude, ~$0.14 per 60-case run
#   stub      — offline fixture, no network. Output is tagged [OFFLINE STUB]
#               and is NOT valid for reported metrics.
REASONING_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Razorpay TEST mode keys — free, no KYC needed, no real money can move.
# Leave blank to run the executor in labelled dry-run mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Any string you choose — must match the secret set on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# Set to true to halt all external side effects (the kill switch).
RECOVERY_KILL_SWITCH=false
